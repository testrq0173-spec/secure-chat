rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Capability-based Unidirectional Message Queues
    match /queues/{queueId} {
      // Allow creation only if caller is authenticated anonymously
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['ownerPublicKey', 'createdAt', 'queueId']) &&
                       request.resource.data.queueId == queueId;
                       
      // Only the queue owner with signed proof or matching auth can read/delete the queue metadata
      allow read: if request.auth != null;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      
      // Packets subcollection inside a Queue
      match /packets/{packetId} {
        // Enforce maximum size limit (e.g., 64KB for text/metadata packet)
        // Rate-limiting / signature verification is handled via Cloud Functions or rule constraints
        allow create: if request.auth != null &&
                         request.resource.data.keys().hasAll(['encryptedPayload', 'nonce', 'timestamp', 'packetId']) &&
                         request.resource.data.encryptedPayload is string &&
                         request.resource.data.encryptedPayload.size() <= 65536;
                         
        // Only reader of this queue can read packets and delete them upon receipt
        allow read: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }
    
    // One-Time Invitations (ephemeral handshakes)
    match /invites/{inviteId} {
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['ephemeralPublicKey', 'queueId', 'expiresAt']);
                       
      allow read: if request.auth != null;
      // Recipient can consume and delete the one-time invite
      allow delete: if request.auth != null;
    }
    
    // Reusable Contact Addresses (Public handles with manual accept/reject)
    match /addresses/{addressId} {
      allow create: if request.auth != null &&
                       request.resource.data.keys().hasAll(['ownerUid', 'inboxQueueId', 'identityPublicKey', 'createdAt']);
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
