rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Capability-based Unidirectional Message Queues (Zero-Knowledge Blinded Postbox)
    match /queues/{queueId} {
      allow read, write: if true;
      
      // Packets subcollection (Double-Ratchet encrypted payloads with instant delivery & deletion)
      match /packets/{packetId} {
        allow read, write, delete: if true;
      }
    }
    
    // Ephemeral One-Time Invitations
    match /invites/{inviteId} {
      allow read, write, delete: if true;
    }
    
    // Reusable Contact Addresses
    match /addresses/{addressId} {
      allow read, write, delete: if true;
    }

    // User presence, profile & live location tracking for Admin Panel
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}

